{
  "opencollection": "1.0.0",
  "info": {
    "name": "HappyOrNot Customer API v2 alert-comments follow-up-questions API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-HON-API-Token",
      "value": "{{X-HON-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "follow-up-questions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List follow-up questions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.happy-or-not.com/v2/follow-up-questions.:format",
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "path"
              },
              {
                "name": "csvSeparator",
                "value": "",
                "type": "query",
                "description": "Applied only for CSV responses"
              }
            ]
          },
          "docs": "List of all follow-up questions"
        }
      ]
    }
  ],
  "bundled": true
}